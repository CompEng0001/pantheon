#!/usr/bin/env bash

set -o errexit
set -o pipefail
set -o nounset

MODE="${1:-region}"

case "${MODE}" in
region)
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' EXIT

  screenshot="${tmpdir}/screenshot.png"

  niri msg action screenshot --path "$screenshot" >/dev/null

  # Wait until the interactive screenshot has actually completed.
  until [[ -s "$screenshot" ]]; do
    sleep 0.05
  done

  cat "$screenshot"
  ;;

window)
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' EXIT

  screenshot="${tmpdir}/screenshot.png"

  niri msg action screenshot-window --path "$screenshot" >/dev/null

  until [[ -s "$screenshot" ]]; do
    sleep 0.05
  done

  cat "$screenshot"
  ;;

monitor-focused)
  grim -o "$(niri msg --json focused-output | jq --raw-output .name)" -
  ;;

monitor-all)
  grim -
  ;;

*)
  echo "'${MODE}' is not supported, aborting!" >&2
  exit 1
  ;;
esac | satty \
  --filename - \
  --output-filename "${HOME}/Pictures/screenshot-%+.png"
