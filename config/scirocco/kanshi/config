profile LAPTOP {
  output eDP-1 enable mode 1920x1080@60.020Hz position 0,0
}

profile HDMI {
  output eDP-1 mode 1920x1080@60.020Hz position 0,0
  output HDMI-A-1  mode 1920x1080@59.997002Hz position 1920,0
}

# Gillingham 403
profile Gillingham_USBC {
  output eDP-1 mode 1920x1080@60.020Hz position 0,0
  output "RGB Systems, Inc. dba Extron Electronics Extron HDMI Unknown" mode 1920x1080@60Hz position 1920,0 
}

profile DISPLAYLINK {
  
  output eDP-1    disable

  output "Iiyama North America PL2493H 1187721200661"  mode 1920x1080@60Hz position 0,0 transform 90

  output "Iiyama North America PL2492H 1225744350418"  mode 1920x1080@60Hz position 1080,0 transform normal scale 0.9

  output "Iiyama North America PL2493H 1187721208215"  mode 1920x1080@60Hz position 3000,0

  exec ~/.config/waybar/start.sh
}

